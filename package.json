{
  "name": "express-entregas-v3-site",
  "version": "3.0.0",
  "private": true,
  "description": "Site e backend do Express Entregas V3.0",
  "scripts": {
    "test": "node --test tests/backend/*.test.cjs",
    "check": "node scripts/check.mjs",
    "build:web": "node scripts/prepare-web.mjs && esbuild native-push-entry.js --bundle --format=iife --outfile=www/vendor/native-push.bundle.js && esbuild firebase-entry.js --bundle --format=iife --minify --outfile=www/vendor/firebase.bundle.js && npm run build:tracking",
    "test:rules": "npm test --prefix tests/firebase-rules",
    "test:browser": "npm run build:web && node scripts/run-browser-emulators.mjs",
    "build:tracking": "node scripts/build-tracking.mjs"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.3.1",
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/push-notifications": "7.0.7",
    "@capacitor/share": "7.0.4",
    "capacitor-native-settings": "7.0.2",
    "firebase": "13.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@playwright/test": "1.56.1",
    "esbuild": "^0.25.11",
    "typescript": "^5.9.3"
  }
}
